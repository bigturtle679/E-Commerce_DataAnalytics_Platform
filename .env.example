# ─── PostgreSQL ───────────────────────────────────────────────
# For local dev: use "localhost"
# For Docker:    use "postgres" (service name = hostname)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ─── Enrichment APIs ─────────────────────────────────────────
# ViaCEP: no key needed (public API)
# ExchangeRate: free key from https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_key_here
API_RETRY_MAX_ATTEMPTS=3
API_RETRY_BACKOFF_BASE=1
API_RETRY_BACKOFF_FACTOR=2
API_REQUEST_TIMEOUT=30

# ─── API Security ────────────────────────────────────────────
# Empty = auth disabled (local dev). Set a value to enable API key auth.
# Protected routes require X-API-Key header when set.
API_KEY=

# ─── Paths ────────────────────────────────────────────────────
# Local: relative path to CSV dataset directory
# Docker: set to /app/dataset or /opt/airflow/dataset (via .env.docker)
DATASET_PATH=./dataset
LOG_LEVEL=INFO

# ─── FastAPI (optional — defaults in code) ────────────────────
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=http://localhost:3000

# ─── Frontend (set in frontend/.env.local for local dev) ──────
# NEXT_PUBLIC_API_URL=http://localhost:8000
